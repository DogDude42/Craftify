{
  "manifest_version": 3,
  "name": "Craftify YTM Bridge",
  "version": "1.0.0",
  "description": "Relays YouTube Music player state and controls to the Craftify Minecraft mod via the native bridge",
  "permissions": [
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "*://music.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://music.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icon128.png"
  }
}